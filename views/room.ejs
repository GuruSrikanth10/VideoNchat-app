<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Meeting · VideoNChat</title>
    <link rel="stylesheet" href="/style.css" />
    <!-- Socket.IO serves its own client, so it always matches the server. -->
    <script src="/socket.io/socket.io.min.js"></script>
    <script src="https://kit.fontawesome.com/c939d0e917.js"></script>
    <script src="/vendor/peerjs/peerjs.min.js"></script>
    <script src="/vendor/sweetalert2/sweetalert2.all.min.js"></script>

    <script>
      const ROOM_ID = "<%= roomId %>";
    </script>
  </head>
  <body>
    <header class="header">
      <div class="logo">

        <button type="button" class="header__back" aria-label="Back to video">
          <i class="fas fa-arrow-left" aria-hidden="true"></i>
        </button>

        <div class="logo_content">

          <div class="options__button" aria-hidden="true">
            <i class="fa-lg fab fa-microsoft"></i>
          </div>

          <div class="logo_text_box">
            <div class="logo_text">
              <h1>VideoNChat</h1>
            </div>
            
          </div>

        </div>
      </div>
      <div class="leave">
        <button type="button" id="leave-meet" class="leave-button options__button">
          <span class="leave-text">Leave</span>
        </button>
      </div>
    </header>
    <main class="main">
    <div class="main__left">
      <div id="network-speed">
        <!-- <p>ResponseTime : </p> -->
        <button type="button" id="network-content">
          <i class="fa fa-signal" aria-hidden="true"></i>
          <span class="visually-hidden">Ping</span>
          <span id="rtt-value"></span>
        </button>
      </div>
      <div class="videos__group">
        <div id="video-grid">
          
        </div>
      </div>
      <div class="options">
        <div class="options__left">
          <button type="button" id="stopVideo" class="options__button" aria-label="Turn camera off" aria-pressed="false">
            <i class="fas fa-video" aria-hidden="true"></i>
          </button>
          <button type="button" id="muteButton" class="options__button" aria-label="Mute microphone" aria-pressed="false">
            <i class="fa fa-microphone" aria-hidden="true"></i>
          </button>
          <button type="button" id="showChat" class="options__button" aria-label="Show chat">
            <i class="fa fa-comment" aria-hidden="true"></i>
          </button>
          <button type="button" id="shareScreen" class="options__button" aria-label="Share screen" aria-pressed="false">
            <i class="fas fa-photo-video" aria-hidden="true"></i>
          </button>
        </div>
        <div class="options__right">
          <button type="button" id="inviteButton" class="options__button" aria-label="Copy invite link">
            <i class="fas fa-user-plus" aria-hidden="true"></i>
          </button>
        </div>
      </div>
    </div>
    <div class="main__right">
      <div class="main__chat_window">
          <div class="messages" role="log" aria-live="polite" aria-label="Chat messages">
          </div>
          <div id="feedback" aria-live="polite"></div>
      </div>
      
      <div class="main__message_container">
        <label for="chat_message" class="visually-hidden">Message</label>
        <input id="chat_message" type="text" autocomplete="off" maxlength="1000" placeholder="Type message here...">
        <button type="button" id="send" class="options__button" aria-label="Send message">
          <i class="fa fa-paper-plane" aria-hidden="true"></i>
        </button>
      </div>
    </div>
  </main>
    <script src="/client.js"></script>
  </body>
</html>
