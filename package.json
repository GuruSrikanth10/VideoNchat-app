{
  "name": "videochat",
  "version": "1.0.0",
  "description": "Video meetings with chat and screen sharing, built on WebRTC.",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "lint": "eslint . && stylelint \"public/**/*.css\" && prettier --check .",
    "format": "prettier --write . && stylelint --fix \"public/**/*.css\"",
    "test": "node --test --test-force-exit --test-timeout=10000 \"test/server/**/*.test.js\"",
    "test:coverage": "node --test --test-force-exit --test-timeout=10000 --experimental-test-coverage --test-coverage-include=app.js --test-coverage-lines=80 \"test/server/**/*.test.js\""
  },
  "author": "Guru SriKanth",
  "license": "ISC",
  "dependencies": {
    "ejs": "^3.1.10",
    "express": "^4.22.3",
    "peer": "^1.0.2",
    "peerjs": "1.5.5",
    "socket.io": "^4.8.4",
    "sweetalert2": "11.26.25",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "socket.io-client": "^4.8.4",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
