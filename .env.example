# Copy to .env (or set these in your host's dashboard). All are optional.

# Port to listen on. Hosting platforms usually set this for you.
PORT=3000

# The public URL of the app. When set, only pages from this origin may
# connect to the realtime API, and invite links get a preview image on
# sites that need absolute URLs (X, Facebook, LinkedIn).
# PUBLIC_URL=https://meet.example.com

# Number of proxies in front of the app (1 on Render, Heroku, Fly.io).
# TRUST_PROXY=1

# People allowed in one room. Every participant sends video to every
# other participant, so keep this small.
# MAX_ROOM_SIZE=6

# How long a dropped connection may take to come back before others are
# told the person left.
# RECONNECT_GRACE_SECONDS=15

# How long to wait for clients after SIGTERM before exiting.
# SHUTDOWN_GRACE_SECONDS=5

# --- Connectivity ---------------------------------------------------------
# Without a TURN server, calls between people on strict networks (corporate
# firewalls, some mobile carriers) can fail. Either run coturn with
# "use-auth-secret" and set TURN_URLS + TURN_SECRET, or paste static
# credentials from a provider into ICE_SERVERS.

# STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:443
# TURN_SECRET=change-me
# TURN_TTL_SECONDS=21600
# ICE_SERVERS=[{"urls":"turns:relay.example.com:443","username":"user","credential":"pass"}]

# --- Operations -----------------------------------------------------------
# debug, info (default), warn, error or silent. Logs are JSON lines without
# names, chat or meeting IDs.
# LOG_LEVEL=info

# Turns on GET /metrics (Prometheus format) for scrapers that send
# "Authorization: Bearer <token>". At least 16 characters; without it
# there are no metrics.
# METRICS_TOKEN=generate-a-long-random-string
